{
    "manifest_version": 3,
    "name": "Browser Bible",
    "version": "2.0",
    "description": "Look up and read Bible passages right from your toolbar.",
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Browser Bible",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "https://bible-api.com/*"
    ],
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+B"
            },
            "description": "Open Browser Bible"
        }
    }
}